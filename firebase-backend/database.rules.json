{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "isVerified": {
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
        },
        "status": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (!data.exists() && newData.val() === 'active'))"
        }
      }
    },
    "usernames": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || data.val() === auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "contacts": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "chats": {
      ".read": "auth != null",
      "$chatId": {
        ".write": "auth != null && (!data.exists() || data.child('participantIds').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },
    "messages": {
      "$chatId": {
        ".read": "auth != null",
        "$msgId": {
          ".write": "auth != null && (newData.child('senderId').val() === auth.uid || data.exists() || root.child('admins').child(auth.uid).exists())"
        }
      }
    },
    "typing": {
      "$chatId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null && (!data.exists() || data.child('adminIds').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },
    "communities": {
      ".read": "auth != null",
      "$communityId": {
        ".write": "auth != null && (!data.exists() || data.child('adminIds').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },
    "stories": {
      ".read": "auth != null",
      "$storyId": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        "viewers": {
          "$viewerUid": {
            ".write": "auth != null && auth.uid === $viewerUid"
          }
        },
        "reactions": {
          "$reactorUid": {
            ".write": "auth != null && auth.uid === $reactorUid"
          }
        }
      }
    },
    "calls": {
      ".read": "auth != null",
      "$callId": {
        ".write": "auth != null"
      }
    },
    "notifications": {
      ".read": "auth != null",
      "$notifId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "verified_users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "blocked_users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$reportId": {
        ".write": "auth != null && ((!data.exists() && newData.child('reporterUid').val() === auth.uid) || root.child('admins').child(auth.uid).exists())"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    },
    "admin_logs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    },
    "app_settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    }
  }
}
